---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection(
    'projects',
    (entry) => import.meta.env.DEV || !entry.data.draft,
  );
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article>
    <header class="article-head">
      <h1>{project.data.title}</h1>
      <p class="entry-meta">
        <FormattedDate date={project.data.date} />
      </p>
      <p class="entry-desc">{project.data.summary}</p>

      {
        project.data.stack.length > 0 && (
          <ul class="badges">
            {project.data.stack.map((tech) => (
              <li class="badge">{tech}</li>
            ))}
          </ul>
        )
      }

      {
        (project.data.repo || project.data.demo) && (
          <div class="hero-links">
            {project.data.repo && <a href={project.data.repo}>Repository</a>}
            {project.data.demo && <a href={project.data.demo}>Live demo</a>}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <a class="back-link" href="/projects">← Projects</a>
</BaseLayout>
