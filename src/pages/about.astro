---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL } from '../consts';
---

<BaseLayout title="About" description={`${SITE.author} 소개`}>
  <section class="hero">
    <h1>About</h1>
    <p>안녕하세요, 백엔드 개발자 {SITE.author}입니다.</p>
    <div class="hero-links">
      {SOCIAL.github && <a href={SOCIAL.github}>GitHub</a>}
      {SOCIAL.email && <a href={`mailto:${SOCIAL.email}`}>Email</a>}
      {SOCIAL.linkedin && <a href={SOCIAL.linkedin}>LinkedIn</a>}
    </div>
  </section>

  <div class="prose">
    <p>
      이 페이지의 내용은 <code>src/pages/about.astro</code> 에서 수정할 수 있습니다.
    </p>

    <h2>기술 스택</h2>
    <ul>
      <li>Backend — Python, FastAPI, PostgreSQL, Redis</li>
      <li>Infra — Docker, AWS</li>
    </ul>
  </div>
</BaseLayout>
